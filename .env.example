# Supabase — Settings → API in your project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Settings → API → service_role key. SECRET — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — https://resend.com/api-keys (free tier: 100 emails/day, 3,000/month).
RESEND_API_KEY=your-resend-api-key
# Must be a verified sender domain/address in Resend, e.g. "ג'אמפו <shifts@yourdomain.com>".
RESEND_FROM_EMAIL="ג'אמפו <onboarding@resend.dev>"

# Full URL of the deployed app (used in email links). For local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
